# SQLite works immediately. Replace with PostgreSQL in deployment:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/freshfusion
DATABASE_URL=sqlite:///./freshfusion.db
CORS_ORIGINS=*
UPLOAD_DIR=../uploads

# Optional local LLM explanation layer.
# FreshFusion core verdict does NOT depend on Ollama/Gemma.
FRESHFUSION_OLLAMA_URL=http://127.0.0.1:11434
FRESHFUSION_OLLAMA_MODEL=gemma3:4b
